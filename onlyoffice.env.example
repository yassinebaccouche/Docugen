# Copy to .env and replace this with a private random value of at least 32 characters.
ONLYOFFICE_JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Address your browser uses to load the ONLYOFFICE editor.
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8080

# Address the ONLYOFFICE container uses to reach this Next.js app on Docker Desktop.
DOCUGEN_PUBLIC_URL=http://host.docker.internal:3000

# Local template working copies and metadata are stored here.
DOCUGEN_DATA_DIR=.docugen-data

# Vercel deployments: set this to the Firebase service-account JSON.
# Keep it server-side and never commit a real service-account key.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary unsigned raw uploads for DOCX templates.
# The defaults match the Cloudinary cloud and preset currently configured in the app.
CLOUDINARY_CLOUD_NAME=yal4swpi
CLOUDINARY_UPLOAD_PRESET=ml_default
